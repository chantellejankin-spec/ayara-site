---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  backLabel?: string;
  backHref?: string;
}

const {
  title,
  description,
  backLabel = 'Focus',
  backHref = '/focus',
} = Astro.props;
---

<Layout title={title} description={description}>
  <article class="section article">
    <div class="wrap article-wrap">
      <p class="eyebrow reveal"><a href={backHref}>&larr; {backLabel}</a></p>
      <h1 class="reveal">{title}</h1>
      <div class="prose reveal">
        <slot />
      </div>
      <div class="cta-row">
        <a class="pill-btn" href="/contact">Talk to Us About This Work</a>
      </div>
    </div>
  </article>
</Layout>

<style>
  .article-wrap {
    max-width: 760px;
  }

  .eyebrow {
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .prose h2 {
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    margin-top: 2em;
  }

  .prose p {
    font-size: 1.02rem;
  }

  .cta-row {
    border-top: 2px solid var(--line);
    padding-top: 2rem;
    margin-top: 2.5rem;
  }
</style>
