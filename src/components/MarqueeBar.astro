---
interface Props {
  text?: string;
}

const { text = 'For Thriving Communities and Living Nature' } = Astro.props;
const items = Array.from({ length: 4 });
---

<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    {[0, 1].map(() => (
      <div class="marquee-set">
        {items.map(() => (
          <span class="marquee-item">
            {text}
            <span class="marquee-arrow">&#8600;</span>
          </span>
        ))}
      </div>
    ))}
  </div>
</div>

<style>
  .marquee {
    background: var(--ink);
    overflow: hidden;
    padding: 1.1rem 0;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 26s linear infinite;
  }

  .marquee-set {
    display: flex;
    flex-shrink: 0;
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    padding: 0 1.5rem;
    font-weight: 800;
    font-size: clamp(1.1rem, 2.4vw, 1.6rem);
    color: var(--sun);
    white-space: nowrap;
  }

  .marquee-arrow {
    color: var(--sun);
    font-size: 0.85em;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
