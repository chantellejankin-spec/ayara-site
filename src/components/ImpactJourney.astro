---
// The ribbon is the client's own reference image, used as-is
// (public/images/journey-ribbon.png, 812x1938), not redrawn as an
// SVG path. The wrapper below is locked to that exact aspect ratio
// so percentage-based pin positions line up with the image pixels
// precisely, however it gets scaled to fit the panel.
const IMG_W = 812;
const IMG_H = 1938;

// Scroll sequence confirmed by the client: Local ideas take root,
// Tools open new pathways, Skills turn into confidence, Communities
// grow shared livelihoods, People and nature thrive together. Pixel
// coordinates (on the 812x1938 source image) traced from the band's
// own centerline: the first knot's rise, its crossing, the open
// S-bend, the second knot's shoulder, and its lower crossing.
const stations = [
  { label: 'Local ideas take root', x: 313.9, y: 190.0 },
  { label: 'Tools open new pathways', x: 582.1, y: 582.9 },
  { label: 'Skills turn into confidence', x: 189.0, y: 1005.8 },
  { label: 'Communities grow shared livelihoods', x: 426.1, y: 1372.0 },
  { label: 'People and nature thrive together', x: 618.0, y: 1763.8 },
].map((s) => ({
  ...s,
  leftPct: (s.x / IMG_W) * 100,
  topPct: (s.y / IMG_H) * 100,
  labelRight: s.x > IMG_W / 2 ? false : true,
}));
---

<section class="journey-section" id="journey">
  <div class="journey-sticky split-section">
    <div class="split-panel forest hero-forest">
      <slot />
    </div>
    <div class="split-panel sky journey-panel">
      <p class="eyebrow reveal">Impact Journey</p>
      <div class="journey-figure">
        <div class="journey-figure-inner">
          <img src="/images/journey-ribbon.png" alt="" aria-hidden="true" />

          {stations.map((s, i) => (
            <div
              class="journey-marker"
              data-index={i}
              style={`left:${s.leftPct}%; top:${s.topPct}%;`}
            >
              <svg class="journey-pin" viewBox="-20 -26 40 52" width="24" height="31">
                <path d="M0 -26 C 12 -26, 20 -17, 20 -6 C 20 8, 0 26, 0 26 C 0 26, -20 8, -20 -6 C -20 -17, -12 -26, 0 -26 Z" />
              </svg>
              <div class={`journey-label side-${s.labelRight ? 'right' : 'left'}`}>
                {s.label}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .journey-section {
    position: relative;
    height: 420vh;
  }

  .journey-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    grid-template-rows: 100vh;
    overflow: hidden;
  }

  .journey-panel {
    position: relative;
  }

  .eyebrow {
    position: absolute;
    top: clamp(1.5rem, 4vh, 2.5rem);
    left: clamp(1.25rem, 4vw, 2.5rem);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--forest-dark);
    z-index: 2;
    margin: 0;
  }

  .journey-figure {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .journey-figure-inner {
    position: relative;
    height: 100%;
    max-width: 100%;
    aspect-ratio: 812 / 1938;
  }

  .journey-figure-inner img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .journey-marker {
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .journey-marker.active {
    opacity: 1;
  }

  .journey-pin {
    flex-shrink: 0;
    overflow: visible;
  }

  .journey-pin path {
    fill: var(--ink);
  }

  .journey-label {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 13rem;
    font-family: "Almarai", Arial, Helvetica, sans-serif;
    font-weight: 800;
    font-size: 1.2rem;
    line-height: 1.25;
    color: var(--forest-dark);
  }

  .journey-label.side-left {
    right: calc(100% + 0.6rem);
    text-align: right;
  }

  .journey-label.side-right {
    left: calc(100% + 0.6rem);
    text-align: left;
  }

  @media (max-width: 900px) {
    .journey-sticky {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      height: auto;
      position: static;
      overflow: visible;
    }

    .journey-section {
      height: auto;
    }

    .journey-panel {
      min-height: 70vh;
    }
  }

  @media (max-width: 640px) {
    .journey-label {
      font-size: 0.95rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .journey-marker {
      transition: none;
    }
  }
</style>

<script>
  const section = document.getElementById('journey');
  const markers = Array.from(document.querySelectorAll<HTMLDivElement>('.journey-marker'));

  if (section && markers.length) {
    let ticking = false;

    const update = () => {
      const rect = section.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      const progress = scrollable > 0
        ? Math.min(0.999, Math.max(0, -rect.top / scrollable))
        : 0;

      const activeIndex = Math.floor(progress * markers.length);

      markers.forEach((m, i) => {
        m.classList.toggle('active', i === activeIndex);
      });

      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true }
    );

    update();
  }
</script>
