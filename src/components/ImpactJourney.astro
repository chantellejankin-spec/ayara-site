---
const stations = [
  { label: 'Skills turn into confidence', x: 600, y: 160, side: 'right', progress: 0.12 },
  { label: 'Tools open new pathways', x: 300, y: 340, side: 'left', progress: 0.32 },
  { label: 'Communities grow shared livelihoods', x: 600, y: 520, side: 'right', progress: 0.52 },
  { label: 'People and nature thrive together', x: 300, y: 700, side: 'left', progress: 0.72 },
  { label: 'Local ideas take root', x: 600, y: 880, side: 'right', progress: 0.92 },
];

const LABEL_W = 260;
const LABEL_H = 120;
---

<section class="journey-section" id="journey">
  <div class="journey-sticky">
    <div class="wrap journey-inner">
      <p class="eyebrow reveal">Impact Journey</p>
      <svg
        class="journey-svg"
        viewBox="0 0 900 1000"
        preserveAspectRatio="xMidYMid meet"
      >
        <path
          id="journey-path"
          d="M 300 40
             C 480 40, 600 100, 600 160
             C 600 220, 300 260, 300 340
             C 300 420, 600 460, 600 520
             C 600 580, 300 620, 300 700
             C 300 780, 480 820, 600 880"
          fill="none"
          stroke="#fffeb8"
          stroke-width="10"
          stroke-linecap="round"
        ></path>

        {stations.map((s) => (
          <circle class="journey-dot" cx={s.x} cy={s.y} r="14" />
        ))}

        {stations.map((s, i) => (
          <foreignObject
            x={s.side === 'right' ? s.x + 30 : s.x - 30 - LABEL_W}
            y={s.y - LABEL_H / 2}
            width={LABEL_W}
            height={LABEL_H}
          >
            <div
              class={`journey-label side-${s.side}`}
              data-progress={s.progress}
              data-index={i}
              xmlns="http://www.w3.org/1999/xhtml"
            >
              {s.label}
            </div>
          </foreignObject>
        ))}
      </svg>
    </div>
  </div>
</section>

<style>
  .journey-section {
    position: relative;
    height: 420vh;
    background: var(--sky);
  }

  .journey-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .journey-inner {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .eyebrow {
    position: absolute;
    top: clamp(1.5rem, 4vh, 2.5rem);
    left: clamp(1.25rem, 4vw, 2.5rem);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--forest-dark);
    z-index: 2;
  }

  .journey-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: visible;
  }

  .journey-dot {
    fill: var(--sky);
    stroke: #fffeb8;
    stroke-width: 6;
    transition: fill 0.3s ease, transform 0.3s ease;
    transform-origin: center;
    transform-box: fill-box;
  }

  .journey-dot.active {
    fill: var(--forest-dark);
    transform: scale(1.3);
  }

  .journey-label {
    font-family: "Almarai", Arial, Helvetica, sans-serif;
    font-weight: 800;
    font-size: 1.15rem;
    line-height: 1.25;
    color: var(--forest-dark);
    opacity: 0.3;
    transform: translateY(8px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    display: flex;
    align-items: center;
    height: 100%;
  }

  .journey-label.side-left {
    justify-content: flex-end;
    text-align: right;
  }

  .journey-label.side-right {
    justify-content: flex-start;
    text-align: left;
  }

  .journey-label.active {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 640px) {
    .journey-section {
      height: 340vh;
    }

    .journey-label {
      font-size: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .journey-dot,
    .journey-label {
      transition: none;
    }
  }
</style>

<script>
  const section = document.getElementById('journey');
  const path = document.getElementById('journey-path') as SVGPathElement | null;
  const dots = Array.from(document.querySelectorAll<SVGCircleElement>('.journey-dot'));
  const labels = Array.from(document.querySelectorAll<HTMLElement>('.journey-label'));
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && path) {
    const length = path.getTotalLength();

    if (prefersReducedMotion) {
      path.style.strokeDasharray = 'none';
      dots.forEach((d) => d.classList.add('active'));
      labels.forEach((l) => l.classList.add('active'));
    } else {
      path.style.strokeDasharray = `${length}`;
      path.style.strokeDashoffset = `${length}`;

      let ticking = false;

      const update = () => {
        const rect = section.getBoundingClientRect();
        const scrollable = rect.height - window.innerHeight;
        const progress = scrollable > 0
          ? Math.min(1, Math.max(0, -rect.top / scrollable))
          : 0;

        path.style.strokeDashoffset = `${length * (1 - progress)}`;

        dots.forEach((dot, i) => {
          const threshold = Number(labels[i]?.dataset.progress ?? 0);
          dot.classList.toggle('active', progress >= threshold);
        });

        labels.forEach((label) => {
          const threshold = Number(label.dataset.progress ?? 0);
          label.classList.toggle('active', progress >= threshold);
        });

        ticking = false;
      };

      window.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(update);
        },
        { passive: true }
      );

      update();
    }
  }
</script>
