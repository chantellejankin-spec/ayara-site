---
// Built point-by-point (not hand-guessed) so every join's tangent
// matches exactly: a real nautilus spiral (radius growing step by
// step around a continuously shifting center, the way the original
// curls from a tight inner coil out to a big loop), then two flowing
// bends, a loop, and a figure-eight. One static viewBox, same scale
// as the original -- no scrolling. Station y's land at 175/400/580/
// 730/970, reasonably even without forcing artificial symmetry on
// organically-sized shapes.
const PATH_D = `
  M 300.00 100.00 L 300.00 200.00
  C 300.00 219.33 315.67 235.00 335.00 235.00
  C 359.85 235.00 380.00 214.85 380.00 190.00
  C 380.00 156.86 353.14 130.00 320.00 130.00
  C 275.82 130.00 240.00 165.82 240.00 210.00
  C 240.00 267.99 287.01 315.00 345.00 315.00
  C 422.32 315.00 485.00 252.32 485.00 175.00
  C 485.00 92.16 417.84 25.00 335.00 25.00
  C 252.16 25.00 185.00 92.16 185.00 175.00
  C 185.00 275.00 230.00 300.00 230.00 400.00
  C 230.00 490.00 420.00 490.00 420.00 580.00
  C 420.00 660.00 300.00 650.00 300.00 730.00
  C 300.00 785.23 255.23 830.00 200.00 830.00
  C 144.77 830.00 100.00 785.23 100.00 730.00
  C 100.00 674.77 144.77 630.00 200.00 630.00
  C 255.23 630.00 300.00 674.77 300.00 730.00
  C 300.00 840.00 350.00 860.00 350.00 970.00
  C 350.00 1011.42 383.58 1045.00 425.00 1045.00
  C 466.42 1045.00 500.00 1011.42 500.00 970.00
  C 500.00 928.58 466.42 895.00 425.00 895.00
  C 383.58 895.00 350.00 928.58 350.00 970.00
  C 350.00 1011.42 316.42 1045.00 275.00 1045.00
  C 233.58 1045.00 200.00 1011.42 200.00 970.00
  C 200.00 928.58 233.58 895.00 275.00 895.00
  C 316.42 895.00 350.00 928.58 350.00 970.00
  L 350.00 1060.00
`;

// Scroll sequence confirmed by the client: Local ideas take root,
// Tools open new pathways, Skills turn into confidence, Communities
// grow shared livelihoods, People and nature thrive together. Each
// pin sits exactly on the path: the spiral's outer end, the two
// flowing bends, the loop's apex, and the figure-eight's outer point.
const stations = [
  { label: 'Local ideas take root', x: 185, y: 175 },
  { label: 'Tools open new pathways', x: 230, y: 400 },
  { label: 'Skills turn into confidence', x: 420, y: 580 },
  { label: 'Communities grow shared livelihoods', x: 300, y: 730 },
  { label: 'People and nature thrive together', x: 200, y: 970 },
].map((s) => ({ ...s, labelRight: s.x > 300 ? false : true }));

const LABEL_W = 250;
const LABEL_H = 110;
---

<section class="journey-section" id="journey">
  <div class="journey-sticky split-section">
    <div class="split-panel forest hero-forest">
      <slot />
    </div>
    <div class="split-panel sky journey-panel">
      <p class="eyebrow reveal">Impact Journey</p>
      <svg class="journey-svg" viewBox="0 0 600 1150" preserveAspectRatio="xMidYMid meet">
        <path
          d={PATH_D}
          fill="none"
          stroke="#fffeb8"
          stroke-width="40"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>

        {stations.map((s, i) => (
          <g class="journey-marker" data-index={i}>
            <path
              class="journey-pin"
              d="M0 -26 C 12 -26, 20 -17, 20 -6 C 20 8, 0 26, 0 26 C 0 26, -20 8, -20 -6 C -20 -17, -12 -26, 0 -26 Z"
              transform={`translate(${s.x}, ${s.y - 14})`}
            />
            <foreignObject
              x={s.labelRight ? s.x + 26 : s.x - 26 - LABEL_W}
              y={s.y - LABEL_H / 2}
              width={LABEL_W}
              height={LABEL_H}
            >
              <div class={`journey-label side-${s.labelRight ? 'right' : 'left'}`} xmlns="http://www.w3.org/1999/xhtml">
                {s.label}
              </div>
            </foreignObject>
          </g>
        ))}
      </svg>
    </div>
  </div>
</section>

<style>
  .journey-section {
    position: relative;
    height: 420vh;
  }

  .journey-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    grid-template-rows: 100vh;
    overflow: hidden;
  }

  .journey-panel {
    position: relative;
  }

  .eyebrow {
    position: absolute;
    top: clamp(1.5rem, 4vh, 2.5rem);
    left: clamp(1.25rem, 4vw, 2.5rem);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--forest-dark);
    z-index: 2;
    margin: 0;
  }

  .journey-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .journey-marker {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .journey-marker.active {
    opacity: 1;
  }

  .journey-pin {
    fill: var(--ink);
  }

  .journey-label {
    font-family: "Almarai", Arial, Helvetica, sans-serif;
    font-weight: 800;
    font-size: 1.2rem;
    line-height: 1.25;
    color: var(--forest-dark);
    display: flex;
    align-items: center;
    height: 100%;
  }

  .journey-label.side-left {
    justify-content: flex-end;
    text-align: right;
  }

  .journey-label.side-right {
    justify-content: flex-start;
    text-align: left;
  }

  @media (max-width: 900px) {
    .journey-sticky {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      height: auto;
      position: static;
      overflow: visible;
    }

    .journey-section {
      height: auto;
    }

    .journey-panel {
      min-height: 70vh;
    }
  }

  @media (max-width: 640px) {
    .journey-label {
      font-size: 0.95rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .journey-marker {
      transition: none;
    }
  }
</style>

<script>
  const section = document.getElementById('journey');
  const markers = Array.from(document.querySelectorAll<SVGGElement>('.journey-marker'));

  if (section && markers.length) {
    let ticking = false;

    const update = () => {
      const rect = section.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      const progress = scrollable > 0
        ? Math.min(0.999, Math.max(0, -rect.top / scrollable))
        : 0;

      const activeIndex = Math.floor(progress * markers.length);

      markers.forEach((m, i) => {
        m.classList.toggle('active', i === activeIndex);
      });

      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true }
    );

    update();
  }
</script>
