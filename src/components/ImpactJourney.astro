---
// A deliberately non-linear ribbon: a process is never a straight
// line. It enters and exits the frame as a clean straight line (no
// fade, no kink at the edge), and winds through two full, generous
// loops plus three gentle bends. Every join below is built so the
// tangent matches exactly on both sides (straight down, at every
// loop's rightmost point and at every bend), so the whole ribbon
// reads as one continuous stroke with no visible seams.
const PATH_D = `
  M 440 -280
  L 440 260
  C 440 337.32 377.32 400 300 400
  C 222.68 400 160 337.32 160 260
  C 160 182.68 222.68 120 300 120
  C 377.32 120 440 182.68 440 260
  C 440 360 370 500 370 600
  C 370 682.84 302.84 750 220 750
  C 137.16 750 70 682.84 70 600
  C 70 517.16 137.16 450 220 450
  C 302.84 450 370 517.16 370 600
  C 370 670 160 670 160 740
  C 160 805 420 805 420 870
  C 420 925 230 925 230 980
  L 230 1200
`;

// Scroll sequence confirmed by the client: Local ideas take root,
// Tools open new pathways, Skills turn into confidence, Communities
// grow shared livelihoods, People and nature thrive together. Each
// pin sits exactly on the path (the loop apex for the first two,
// the bend's resting point for the rest).
const stations = [
  { label: 'Local ideas take root', x: 300, y: 120 },
  { label: 'Tools open new pathways', x: 220, y: 450 },
  { label: 'Skills turn into confidence', x: 160, y: 740 },
  { label: 'Communities grow shared livelihoods', x: 420, y: 870 },
  { label: 'People and nature thrive together', x: 230, y: 980 },
].map((s) => ({ ...s, labelRight: s.x > 300 ? false : true }));

const LABEL_W = 250;
const LABEL_H = 110;
---

<section class="journey-section" id="journey">
  <div class="journey-sticky split-section">
    <div class="split-panel forest hero-forest">
      <slot />
    </div>
    <div class="split-panel sky journey-panel">
      <p class="eyebrow reveal">Impact Journey</p>
      <svg class="journey-svg" viewBox="0 0 600 1000" preserveAspectRatio="xMidYMid meet">
        <path
          d={PATH_D}
          fill="none"
          stroke="#fffeb8"
          stroke-width="34"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>

        {stations.map((s, i) => (
          <g class="journey-marker" data-index={i}>
            <path
              class="journey-pin"
              d="M0 -26 C 12 -26, 20 -17, 20 -6 C 20 8, 0 26, 0 26 C 0 26, -20 8, -20 -6 C -20 -17, -12 -26, 0 -26 Z"
              transform={`translate(${s.x}, ${s.y - 14})`}
            />
            <foreignObject
              x={s.labelRight ? s.x + 26 : s.x - 26 - LABEL_W}
              y={s.y - LABEL_H / 2}
              width={LABEL_W}
              height={LABEL_H}
            >
              <div class={`journey-label side-${s.labelRight ? 'right' : 'left'}`} xmlns="http://www.w3.org/1999/xhtml">
                {s.label}
              </div>
            </foreignObject>
          </g>
        ))}
      </svg>
    </div>
  </div>
</section>

<style>
  .journey-section {
    position: relative;
    height: 420vh;
  }

  .journey-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    grid-template-rows: 100vh;
    overflow: hidden;
  }

  .journey-panel {
    position: relative;
  }

  .eyebrow {
    position: absolute;
    top: clamp(1.5rem, 4vh, 2.5rem);
    left: clamp(1.25rem, 4vw, 2.5rem);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--forest-dark);
    z-index: 2;
    margin: 0;
  }

  .journey-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .journey-marker {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .journey-marker.active {
    opacity: 1;
  }

  .journey-pin {
    fill: var(--ink);
  }

  .journey-label {
    font-family: "Almarai", Arial, Helvetica, sans-serif;
    font-weight: 800;
    font-size: 1.2rem;
    line-height: 1.25;
    color: var(--forest-dark);
    display: flex;
    align-items: center;
    height: 100%;
  }

  .journey-label.side-left {
    justify-content: flex-end;
    text-align: right;
  }

  .journey-label.side-right {
    justify-content: flex-start;
    text-align: left;
  }

  @media (max-width: 900px) {
    .journey-sticky {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      height: auto;
      position: static;
      overflow: visible;
    }

    .journey-section {
      height: auto;
    }

    .journey-panel {
      min-height: 70vh;
    }
  }

  @media (max-width: 640px) {
    .journey-label {
      font-size: 0.95rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .journey-marker {
      transition: none;
    }
  }
</style>

<script>
  const section = document.getElementById('journey');
  const markers = Array.from(document.querySelectorAll<SVGGElement>('.journey-marker'));

  if (section && markers.length) {
    let ticking = false;

    const update = () => {
      const rect = section.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      const progress = scrollable > 0
        ? Math.min(0.999, Math.max(0, -rect.top / scrollable))
        : 0;

      const activeIndex = Math.floor(progress * markers.length);

      markers.forEach((m, i) => {
        m.classList.toggle('active', i === activeIndex);
      });

      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true }
    );

    update();
  }
</script>
