---
// Modeled directly on a reference photo of the original ribbon the
// client sent: one continuous, self-crossing band that uses the
// full width of the panel and loosely winds and knots on itself,
// not a tidy spiral or separate circles. Built from a waypoint list
// run through a Catmull-Rom-to-bezier conversion, which gives every
// point a smooth, organically-varying tangent automatically (derived
// from its neighbors) instead of forcing a rigid geometric shape.
const PATH_D = `
  M 100.00 -60.00
  C 136.67 -45.00 250.00 -3.33 320.00 30.00
  C 390.00 63.33 500.00 95.00 520.00 140.00
  C 540.00 185.00 483.33 268.33 440.00 300.00
  C 396.67 331.67 278.33 303.33 260.00 330.00
  C 241.67 356.67 290.00 443.33 330.00 460.00
  C 370.00 476.67 461.67 460.00 500.00 430.00
  C 538.33 400.00 571.67 323.33 560.00 280.00
  C 548.33 236.67 486.67 181.67 430.00 170.00
  C 373.33 158.33 276.67 176.67 220.00 210.00
  C 163.33 243.33 108.33 315.00 90.00 370.00
  C 71.67 425.00 76.67 496.67 110.00 540.00
  C 143.33 583.33 226.67 610.00 290.00 630.00
  C 353.33 650.00 441.67 631.67 490.00 660.00
  C 538.33 688.33 585.00 760.00 580.00 800.00
  C 575.00 840.00 513.33 883.33 460.00 900.00
  C 406.67 916.67 318.33 913.33 260.00 900.00
  C 201.67 886.67 143.33 811.67 110.00 820.00
  C 76.67 828.33 58.33 906.67 60.00 950.00
  C 61.67 993.33 78.33 1048.33 120.00 1080.00
  C 161.67 1111.67 248.33 1138.33 310.00 1140.00
  C 371.67 1141.67 451.67 1121.67 490.00 1090.00
  C 528.33 1058.33 553.33 985.00 540.00 950.00
  C 526.67 915.00 456.67 876.67 410.00 880.00
  C 363.33 883.33 288.33 931.67 260.00 970.00
  C 231.67 1008.33 221.67 1068.33 240.00 1110.00
  C 258.33 1151.67 326.67 1191.67 370.00 1220.00
  C 413.33 1248.33 478.33 1270.00 500.00 1280.00
`;

// Scroll sequence confirmed by the client: Local ideas take root,
// Tools open new pathways, Skills turn into confidence, Communities
// grow shared livelihoods, People and nature thrive together. Each
// pin sits on a waypoint the band actually passes through: the first
// knot's peak, its lower crossing, the open S-bend, the second
// knot's shoulder, and its tail as it flows toward the exit.
const stations = [
  { label: 'Local ideas take root', x: 520, y: 140 },
  { label: 'Tools open new pathways', x: 330, y: 460 },
  { label: 'Skills turn into confidence', x: 580, y: 800 },
  { label: 'Communities grow shared livelihoods', x: 120, y: 1080 },
  { label: 'People and nature thrive together', x: 500, y: 1280 },
].map((s) => ({ ...s, labelRight: s.x > 325 ? false : true }));

const LABEL_W = 250;
const LABEL_H = 110;
---

<section class="journey-section" id="journey">
  <div class="journey-sticky split-section">
    <div class="split-panel forest hero-forest">
      <slot />
    </div>
    <div class="split-panel sky journey-panel">
      <p class="eyebrow reveal">Impact Journey</p>
      <svg class="journey-svg" viewBox="0 -100 650 1450" preserveAspectRatio="xMidYMid meet">
        <path
          d={PATH_D}
          fill="none"
          stroke="#fffeb8"
          stroke-width="40"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>

        {stations.map((s, i) => (
          <g class="journey-marker" data-index={i}>
            <path
              class="journey-pin"
              d="M0 -26 C 12 -26, 20 -17, 20 -6 C 20 8, 0 26, 0 26 C 0 26, -20 8, -20 -6 C -20 -17, -12 -26, 0 -26 Z"
              transform={`translate(${s.x}, ${s.y - 14})`}
            />
            <foreignObject
              x={s.labelRight ? s.x + 26 : s.x - 26 - LABEL_W}
              y={s.y - LABEL_H / 2}
              width={LABEL_W}
              height={LABEL_H}
            >
              <div class={`journey-label side-${s.labelRight ? 'right' : 'left'}`} xmlns="http://www.w3.org/1999/xhtml">
                {s.label}
              </div>
            </foreignObject>
          </g>
        ))}
      </svg>
    </div>
  </div>
</section>

<style>
  .journey-section {
    position: relative;
    height: 420vh;
  }

  .journey-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    grid-template-rows: 100vh;
    overflow: hidden;
  }

  .journey-panel {
    position: relative;
  }

  .eyebrow {
    position: absolute;
    top: clamp(1.5rem, 4vh, 2.5rem);
    left: clamp(1.25rem, 4vw, 2.5rem);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--forest-dark);
    z-index: 2;
    margin: 0;
  }

  .journey-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .journey-marker {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .journey-marker.active {
    opacity: 1;
  }

  .journey-pin {
    fill: var(--ink);
  }

  .journey-label {
    font-family: "Almarai", Arial, Helvetica, sans-serif;
    font-weight: 800;
    font-size: 1.2rem;
    line-height: 1.25;
    color: var(--forest-dark);
    display: flex;
    align-items: center;
    height: 100%;
  }

  .journey-label.side-left {
    justify-content: flex-end;
    text-align: right;
  }

  .journey-label.side-right {
    justify-content: flex-start;
    text-align: left;
  }

  @media (max-width: 900px) {
    .journey-sticky {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      height: auto;
      position: static;
      overflow: visible;
    }

    .journey-section {
      height: auto;
    }

    .journey-panel {
      min-height: 70vh;
    }
  }

  @media (max-width: 640px) {
    .journey-label {
      font-size: 0.95rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .journey-marker {
      transition: none;
    }
  }
</style>

<script>
  const section = document.getElementById('journey');
  const markers = Array.from(document.querySelectorAll<SVGGElement>('.journey-marker'));

  if (section && markers.length) {
    let ticking = false;

    const update = () => {
      const rect = section.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      const progress = scrollable > 0
        ? Math.min(0.999, Math.max(0, -rect.top / scrollable))
        : 0;

      const activeIndex = Math.floor(progress * markers.length);

      markers.forEach((m, i) => {
        m.classList.toggle('active', i === activeIndex);
      });

      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true }
    );

    update();
  }
</script>
