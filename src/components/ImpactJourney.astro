---
const stations = [
  { label: 'Skills turn into confidence', progress: 0.12 },
  { label: 'Tools open new pathways', progress: 0.32 },
  { label: 'Communities grow shared livelihoods', progress: 0.52 },
  { label: 'People and nature thrive together', progress: 0.72 },
  { label: 'Local ideas take root', progress: 0.92 },
];

const points = [
  { x: 340, y: 220 },
  { x: 60, y: 380 },
  { x: 340, y: 540 },
  { x: 60, y: 700 },
  { x: 340, y: 860 },
];
---

<section class="journey-section" id="journey">
  <div class="journey-sticky">
    <div class="wrap journey-inner">
      <p class="eyebrow reveal">Impact Journey</p>
      <svg
        class="journey-svg"
        viewBox="0 0 400 900"
        preserveAspectRatio="xMidYMid meet"
        aria-hidden="true"
      >
        <path
          id="journey-path"
          d="M 60 40
             C 200 40, 340 140, 340 220
             C 340 300, 60 300, 60 380
             C 60 460, 340 460, 340 540
             C 340 620, 60 620, 60 700
             C 60 780, 200 780, 340 860"
          fill="none"
          stroke="#fffeb8"
          stroke-width="10"
          stroke-linecap="round"
        ></path>
        {points.map((p) => (
          <circle class="journey-dot" cx={p.x} cy={p.y} r="14" />
        ))}
      </svg>
      <div class="journey-labels">
        {stations.map((s, i) => (
          <p class="journey-label" data-progress={s.progress} data-index={i}>
            {s.label}
          </p>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .journey-section {
    position: relative;
    height: 420vh;
    background: var(--sky);
  }

  .journey-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .journey-inner {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .eyebrow {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--forest-dark);
    margin-bottom: 0.5rem;
  }

  .journey-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .journey-dot {
    fill: var(--sky);
    stroke: #fffeb8;
    stroke-width: 6;
    transition: fill 0.3s ease, transform 0.3s ease;
    transform-origin: center;
    transform-box: fill-box;
  }

  .journey-dot.active {
    fill: var(--forest-dark);
    transform: scale(1.3);
  }

  .journey-labels {
    position: relative;
    z-index: 1;
    height: 100%;
  }

  .journey-label {
    position: absolute;
    max-width: 220px;
    font-weight: 800;
    font-size: clamp(1rem, 1.8vw, 1.3rem);
    color: var(--forest-dark);
    opacity: 0.25;
    transform: translateY(10px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    margin: 0;
  }

  .journey-label.active {
    opacity: 1;
    transform: translateY(0);
  }

  .journey-label[data-index="0"] { top: 16%; left: 62%; text-align: left; }
  .journey-label[data-index="1"] { top: 38%; left: 4%; text-align: left; }
  .journey-label[data-index="2"] { top: 56%; left: 62%; text-align: left; }
  .journey-label[data-index="3"] { top: 74%; left: 4%; text-align: left; }
  .journey-label[data-index="4"] { top: 92%; left: 62%; text-align: left; }

  @media (max-width: 640px) {
    .journey-section {
      height: 340vh;
    }

    .journey-svg {
      opacity: 0.55;
    }

    .journey-label {
      max-width: 62%;
      font-size: 0.95rem;
    }

    .journey-label[data-index="0"] { left: 34%; }
    .journey-label[data-index="1"] { left: 4%; }
    .journey-label[data-index="2"] { left: 34%; }
    .journey-label[data-index="3"] { left: 4%; }
    .journey-label[data-index="4"] { left: 34%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .journey-dot,
    .journey-label {
      transition: none;
    }
  }
</style>

<script>
  const section = document.getElementById('journey');
  const path = document.getElementById('journey-path') as SVGPathElement | null;
  const dots = Array.from(document.querySelectorAll<SVGCircleElement>('.journey-dot'));
  const labels = Array.from(document.querySelectorAll<HTMLElement>('.journey-label'));
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && path) {
    const length = path.getTotalLength();

    if (prefersReducedMotion) {
      path.style.strokeDasharray = 'none';
      dots.forEach((d) => d.classList.add('active'));
      labels.forEach((l) => l.classList.add('active'));
    } else {
      path.style.strokeDasharray = `${length}`;
      path.style.strokeDashoffset = `${length}`;

      let ticking = false;

      const update = () => {
        const rect = section.getBoundingClientRect();
        const scrollable = rect.height - window.innerHeight;
        const progress = scrollable > 0
          ? Math.min(1, Math.max(0, -rect.top / scrollable))
          : 0;

        path.style.strokeDashoffset = `${length * (1 - progress)}`;

        dots.forEach((dot, i) => {
          const threshold = Number(labels[i]?.dataset.progress ?? 0);
          dot.classList.toggle('active', progress >= threshold);
        });

        labels.forEach((label) => {
          const threshold = Number(label.dataset.progress ?? 0);
          label.classList.toggle('active', progress >= threshold);
        });

        ticking = false;
      };

      window.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(update);
        },
        { passive: true }
      );

      update();
    }
  }
</script>
