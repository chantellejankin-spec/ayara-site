---
// A single static viewBox, same scale as the original: the ribbon
// is not a long path to scroll through, it is one compact shape
// (slightly taller than the panel so it can enter/exit off-frame
// cleanly top and bottom). Its five stations are spaced evenly
// (200 units apart) so none of them bunch up. The shapes vary on
// purpose -- a small ring, a big loop, two flowing bends, an oval,
// a figure-eight -- echoing the original's windings instead of
// repeating one circle. Every join's tangent matches on both sides
// so the stroke reads as one continuous line, no kinks.
const PATH_D = `
  M 345 -170
  L 345 -20
  C 345 4.85 324.85 25 300 25
  C 275.15 25 255 4.85 255 -20
  C 255 -44.85 275.15 -65 300 -65
  C 324.85 -65 345 -44.85 345 -20
  C 345 50 395 30 395 100
  C 395 146.9 356.9 185 310 185
  C 263.1 185 225 146.9 225 100
  C 225 53.1 263.1 15 310 15
  C 356.9 15 395 53.1 395 100
  C 395 190 250 210 250 300
  C 250 390 430 410 430 500
  C 430 630 390 690 390 820
  C 390 886.3 349.7 940 300 940
  C 250.3 940 210 886.3 210 820
  C 210 753.7 250.3 700 300 700
  C 349.7 700 390 753.7 390 820
  C 390 890 350 830 350 900
  C 350 933.1 323.1 960 290 960
  C 256.9 960 230 933.1 230 900
  C 230 866.9 256.9 840 290 840
  C 323.1 840 350 866.9 350 900
  C 350 933.1 376.9 960 410 960
  C 443.1 960 470 933.1 470 900
  C 470 866.9 443.1 840 410 840
  C 376.9 840 350 866.9 350 900
  L 350 1100
`;

// Scroll sequence confirmed by the client: Local ideas take root,
// Tools open new pathways, Skills turn into confidence, Communities
// grow shared livelihoods, People and nature thrive together. Each
// pin sits exactly on the path: the big loop's left point, the two
// flowing bends, the oval's top, and the figure-eight's right loop.
// Evenly spaced 200 units apart so the five stations read as one
// steady progression down the panel.
const stations = [
  { label: 'Local ideas take root', x: 225, y: 100 },
  { label: 'Tools open new pathways', x: 250, y: 300 },
  { label: 'Skills turn into confidence', x: 430, y: 500 },
  { label: 'Communities grow shared livelihoods', x: 300, y: 700 },
  { label: 'People and nature thrive together', x: 470, y: 900 },
].map((s) => ({ ...s, labelRight: s.x > 300 ? false : true }));

const LABEL_W = 250;
const LABEL_H = 110;
---

<section class="journey-section" id="journey">
  <div class="journey-sticky split-section">
    <div class="split-panel forest hero-forest">
      <slot />
    </div>
    <div class="split-panel sky journey-panel">
      <p class="eyebrow reveal">Impact Journey</p>
      <svg class="journey-svg" viewBox="0 0 600 1000" preserveAspectRatio="xMidYMid meet">
        <path
          d={PATH_D}
          fill="none"
          stroke="#fffeb8"
          stroke-width="40"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>

        {stations.map((s, i) => (
          <g class="journey-marker" data-index={i}>
            <path
              class="journey-pin"
              d="M0 -26 C 12 -26, 20 -17, 20 -6 C 20 8, 0 26, 0 26 C 0 26, -20 8, -20 -6 C -20 -17, -12 -26, 0 -26 Z"
              transform={`translate(${s.x}, ${s.y - 14})`}
            />
            <foreignObject
              x={s.labelRight ? s.x + 26 : s.x - 26 - LABEL_W}
              y={s.y - LABEL_H / 2}
              width={LABEL_W}
              height={LABEL_H}
            >
              <div class={`journey-label side-${s.labelRight ? 'right' : 'left'}`} xmlns="http://www.w3.org/1999/xhtml">
                {s.label}
              </div>
            </foreignObject>
          </g>
        ))}
      </svg>
    </div>
  </div>
</section>

<style>
  .journey-section {
    position: relative;
    height: 420vh;
  }

  .journey-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    grid-template-rows: 100vh;
    overflow: hidden;
  }

  .journey-panel {
    position: relative;
  }

  .eyebrow {
    position: absolute;
    top: clamp(1.5rem, 4vh, 2.5rem);
    left: clamp(1.25rem, 4vw, 2.5rem);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--forest-dark);
    z-index: 2;
    margin: 0;
  }

  .journey-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .journey-marker {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .journey-marker.active {
    opacity: 1;
  }

  .journey-pin {
    fill: var(--ink);
  }

  .journey-label {
    font-family: "Almarai", Arial, Helvetica, sans-serif;
    font-weight: 800;
    font-size: 1.2rem;
    line-height: 1.25;
    color: var(--forest-dark);
    display: flex;
    align-items: center;
    height: 100%;
  }

  .journey-label.side-left {
    justify-content: flex-end;
    text-align: right;
  }

  .journey-label.side-right {
    justify-content: flex-start;
    text-align: left;
  }

  @media (max-width: 900px) {
    .journey-sticky {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      height: auto;
      position: static;
      overflow: visible;
    }

    .journey-section {
      height: auto;
    }

    .journey-panel {
      min-height: 70vh;
    }
  }

  @media (max-width: 640px) {
    .journey-label {
      font-size: 0.95rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .journey-marker {
      transition: none;
    }
  }
</style>

<script>
  const section = document.getElementById('journey');
  const markers = Array.from(document.querySelectorAll<SVGGElement>('.journey-marker'));

  if (section && markers.length) {
    let ticking = false;

    const update = () => {
      const rect = section.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      const progress = scrollable > 0
        ? Math.min(0.999, Math.max(0, -rect.top / scrollable))
        : 0;

      const activeIndex = Math.floor(progress * markers.length);

      markers.forEach((m, i) => {
        m.classList.toggle('active', i === activeIndex);
      });

      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true }
    );

    update();
  }
</script>
