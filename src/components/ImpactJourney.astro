---
// Matches the original site: one long ribbon, much taller than the
// panel, that the viewer scrolls through (the SVG viewBox's y-offset
// animates on scroll, see the <script> below) rather than a short
// path squeezed into a single static screen. That is what gives each
// station its own generous stretch instead of bunching them up. The
// shapes vary deliberately (a small ring, a big loop, two flowing
// bends, a tall oval, a figure-eight) instead of repeating the same
// circle, same as the reference. Every join's tangent matches on
// both sides so the stroke reads as one continuous line.
const PATH_D = `
  M 365 -150
  L 365 120
  C 365 155.9 335.9 185 300 185
  C 264.1 185 235 155.9 235 120
  C 235 84.1 264.1 55 300 55
  C 335.9 55 365 84.1 365 120
  C 365 280 580 340 580 500
  C 580 621.5 481.5 720 360 720
  C 238.5 720 140 621.5 140 500
  C 140 378.5 238.5 280 360 280
  C 481.5 280 580 378.5 580 500
  C 580 680 280 770 280 950
  C 280 1150 520 1200 520 1400
  C 520 1650 460 1750 460 2000
  C 460 2121.5 388.4 2220 300 2220
  C 211.6 2220 140 2121.5 140 2000
  C 140 1878.5 211.6 1780 300 1780
  C 388.4 1780 460 1878.5 460 2000
  C 460 2180 350 2170 350 2350
  C 350 2410.75 300.75 2460 240 2460
  C 179.25 2460 130 2410.75 130 2350
  C 130 2289.25 179.25 2240 240 2240
  C 300.75 2240 350 2289.25 350 2350
  C 350 2410.75 399.25 2460 460 2460
  C 520.75 2460 570 2410.75 570 2350
  C 570 2289.25 520.75 2240 460 2240
  C 399.25 2240 350 2289.25 350 2350
  L 350 2850
`;

// Scroll sequence confirmed by the client: Local ideas take root,
// Tools open new pathways, Skills turn into confidence, Communities
// grow shared livelihoods, People and nature thrive together. Each
// pin sits exactly on the path: the big loop's left point, the two
// flowing bends, the oval's top, and the figure-eight's right loop.
const stations = [
  { label: 'Local ideas take root', x: 140, y: 500 },
  { label: 'Tools open new pathways', x: 280, y: 950 },
  { label: 'Skills turn into confidence', x: 520, y: 1400 },
  { label: 'Communities grow shared livelihoods', x: 300, y: 1780 },
  { label: 'People and nature thrive together', x: 570, y: 2350 },
].map((s) => ({ ...s, labelRight: s.x > 300 ? false : true }));

// The viewBox y-offset animates between these two values as the user
// scrolls, so the 1000-tall viewing window pans down the full path
// above. VB_MAX is set so the window's center reaches the last
// station's y exactly at the end of the scroll range.
const VB_MIN = -150;
const VB_MAX = 1850;

const LABEL_W = 250;
const LABEL_H = 110;
---

<section class="journey-section" id="journey">
  <div class="journey-sticky split-section">
    <div class="split-panel forest hero-forest">
      <slot />
    </div>
    <div class="split-panel sky journey-panel">
      <p class="eyebrow reveal">Impact Journey</p>
      <svg class="journey-svg" viewBox={`0 ${VB_MIN} 600 1000`} preserveAspectRatio="xMidYMid meet">
        <path
          d={PATH_D}
          fill="none"
          stroke="#fffeb8"
          stroke-width="34"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>

        {stations.map((s, i) => (
          <g class="journey-marker" data-index={i}>
            <path
              class="journey-pin"
              d="M0 -26 C 12 -26, 20 -17, 20 -6 C 20 8, 0 26, 0 26 C 0 26, -20 8, -20 -6 C -20 -17, -12 -26, 0 -26 Z"
              transform={`translate(${s.x}, ${s.y - 14})`}
            />
            <foreignObject
              x={s.labelRight ? s.x + 26 : s.x - 26 - LABEL_W}
              y={s.y - LABEL_H / 2}
              width={LABEL_W}
              height={LABEL_H}
            >
              <div class={`journey-label side-${s.labelRight ? 'right' : 'left'}`} xmlns="http://www.w3.org/1999/xhtml">
                {s.label}
              </div>
            </foreignObject>
          </g>
        ))}
      </svg>
    </div>
  </div>
</section>

<style>
  .journey-section {
    position: relative;
    height: 420vh;
  }

  .journey-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    grid-template-rows: 100vh;
    overflow: hidden;
  }

  .journey-panel {
    position: relative;
  }

  .eyebrow {
    position: absolute;
    top: clamp(1.5rem, 4vh, 2.5rem);
    left: clamp(1.25rem, 4vw, 2.5rem);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--forest-dark);
    z-index: 2;
    margin: 0;
  }

  .journey-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .journey-marker {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .journey-marker.active {
    opacity: 1;
  }

  .journey-pin {
    fill: var(--ink);
  }

  .journey-label {
    font-family: "Almarai", Arial, Helvetica, sans-serif;
    font-weight: 800;
    font-size: 1.2rem;
    line-height: 1.25;
    color: var(--forest-dark);
    display: flex;
    align-items: center;
    height: 100%;
  }

  .journey-label.side-left {
    justify-content: flex-end;
    text-align: right;
  }

  .journey-label.side-right {
    justify-content: flex-start;
    text-align: left;
  }

  @media (max-width: 900px) {
    .journey-sticky {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      height: auto;
      position: static;
      overflow: visible;
    }

    .journey-section {
      height: auto;
    }

    .journey-panel {
      min-height: 70vh;
    }
  }

  @media (max-width: 640px) {
    .journey-label {
      font-size: 0.95rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .journey-marker {
      transition: none;
    }
  }
</style>

<script>
  const section = document.getElementById('journey');
  const svg = document.querySelector<SVGSVGElement>('.journey-svg');
  const markers = Array.from(document.querySelectorAll<SVGGElement>('.journey-marker'));

  // Must match VB_MIN / VB_MAX and each station's y in the frontmatter above.
  const VB_MIN = -150;
  const VB_MAX = 1850;
  const STATION_YS = [500, 950, 1400, 1780, 2350];

  if (section && svg && markers.length) {
    let ticking = false;

    const update = () => {
      const rect = section.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      const progress = scrollable > 0
        ? Math.min(1, Math.max(0, -rect.top / scrollable))
        : 0;

      const viewBoxY = VB_MIN + progress * (VB_MAX - VB_MIN);
      svg.setAttribute('viewBox', `0 ${viewBoxY} 600 1000`);

      // Whichever station sits nearest the center of the current
      // viewing window is the active one, so the pin stays correct
      // regardless of how unevenly the stations are spaced along
      // the path.
      const viewCenter = viewBoxY + 500;
      let nearest = 0;
      let bestDist = Infinity;
      STATION_YS.forEach((y, i) => {
        const d = Math.abs(y - viewCenter);
        if (d < bestDist) {
          bestDist = d;
          nearest = i;
        }
      });

      markers.forEach((m, i) => {
        m.classList.toggle('active', i === nearest);
      });

      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true }
    );

    update();
  }
</script>
