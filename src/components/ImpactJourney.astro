// Scroll sequence confirmed by the client: Local ideas take root,
// Tools open new pathways, Skills turn into confidence, Communities
// grow shared livelihoods, People and nature thrive together. Each
// pin sits on an actual traced waypoint, evenly spaced along the
// path's length: the first knot's rise, its crossing, the open
// S-bend, the second knot's shoulder, and its lower crossing.
const stations = [
  { label: 'Local ideas take root', x: 224.15, y: 135.66 },
  { label: 'Tools open new pathways', x: 415.65, y: 416.16 },
  { label: 'Skills turn into confidence', x: 134.95, y: 718.13 },
  { label: 'Communities grow shared livelihoods', x: 304.22, y: 979.61 },
  { label: 'People and nature thrive together', x: 441.25, y: 1259.37 },
].map((s) => ({ ...s, labelRight: s.x > 300 ? false : true }));

const LABEL_W = 250;
const LABEL_H = 110;
---

<section class="journey-section" id="journey">
  <div class="journey-sticky split-section">
    <div class="split-panel forest hero-forest">
      <slot />
    </div>
    <div class="split-panel sky journey-panel">
      <p class="eyebrow reveal">Impact Journey</p>
      <svg class="journey-svg" viewBox="0 0 600 1400" preserveAspectRatio="xMidYMid meet">
        <path
          d={PATH_D}
          fill="none"
          stroke="#fffeb8"
          stroke-width="43"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>

        {stations.map((s, i) => (
          <g class="journey-marker" data-index={i}>
            <path
              class="journey-pin"
              d="M0 -26 C 12 -26, 20 -17, 20 -6 C 20 8, 0 26, 0 26 C 0 26, -20 8, -20 -6 C -20 -17, -12 -26, 0 -26 Z"
              transform={`translate(${s.x}, ${s.y - 14})`}
            />
            <foreignObject
              x={s.labelRight ? s.x + 26 : s.x - 26 - LABEL_W}
              y={s.y - LABEL_H / 2}
              width={LABEL_W}
              height={LABEL_H}
            >
              <div class={`journey-label side-${s.labelRight ? 'right' : 'left'}`} xmlns="http://www.w3.org/1999/xhtml">
                {s.label}
              </div>
            </foreignObject>
          </g>
        ))}
      </svg>
    </div>
  </div>
</section>

<style>
  .journey-section {
    position: relative;
    height: 420vh;
  }

  .journey-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    grid-template-rows: 100vh;
    overflow: hidden;
  }

  .journey-panel {
    position: relative;
  }

  .eyebrow {
    position: absolute;
    top: clamp(1.5rem, 4vh, 2.5rem);
    left: clamp(1.25rem, 4vw, 2.5rem);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--forest-dark);
    z-index: 2;
    margin: 0;
  }

  .journey-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .journey-marker {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .journey-marker.active {
    opacity: 1;
  }

  .journey-pin {
    fill: var(--ink);
  }

  .journey-label {
    font-family: "Almarai", Arial, Helvetica, sans-serif;
    font-weight: 800;
    font-size: 1.2rem;
    line-height: 1.25;
    color: var(--forest-dark);
    display: flex;
    align-items: center;
    height: 100%;
  }

  .journey-label.side-left {
    justify-content: flex-end;
    text-align: right;
  }

  .journey-label.side-right {
    justify-content: flex-start;
    text-align: left;
  }

  @media (max-width: 900px) {
    .journey-sticky {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      height: auto;
      position: static;
      overflow: visible;
    }

    .journey-section {
      height: auto;
    }

    .journey-panel {
      min-height: 70vh;
    }
  }

  @media (max-width: 640px) {
    .journey-label {
      font-size: 0.95rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .journey-marker {
      transition: none;
    }
  }
</style>

<script>
  const section = document.getElementById('journey');
  const markers = Array.from(document.querySelectorAll<SVGGElement>('.journey-marker'));

  if (section && markers.length) {
    let ticking = false;

    const update = () => {
      const rect = section.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      const progress = scrollable > 0
        ? Math.min(0.999, Math.max(0, -rect.top / scrollable))
        : 0;

      const activeIndex = Math.floor(progress * markers.length);

      markers.forEach((m, i) => {
        m.classList.toggle('active', i === activeIndex);
      });

      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true }
    );

    update();
  }
</script>
